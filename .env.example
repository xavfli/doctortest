# Copy to .env and fill in real values before deploying. Never commit .env.

# --- Required in production -------------------------------------------------
# Long random string. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret

# Credentials for the two accounts created on first run.
# CHANGE BOTH before exposing the site to a network.
DEFAULT_ADMIN_EMAIL=admin@osh.uz
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
DEFAULT_TEACHER_EMAIL=teacher@osh.uz
DEFAULT_TEACHER_PASSWORD=CHANGE_ME_strong_teacher_password

# --- Networking -------------------------------------------------------------
# 127.0.0.1 when running behind nginx, 0.0.0.0 for a direct public deployment.
HOST=127.0.0.1
PORT=8000

# Only needed if the frontend is served from a different origin.
# Leave empty when nginx serves both the API and the frontend.
CORS_ORIGINS=

# --- Behaviour --------------------------------------------------------------
# Close sign-ups once your cohort has registered.
ALLOW_REGISTRATION=true
ACCESS_TOKEN_EXPIRE_MINUTES=720
QUESTIONS_PER_BLOCK=20
ATTEMPT_TIME_LIMIT_MINUTES=30
DB_PATH=data/app.db